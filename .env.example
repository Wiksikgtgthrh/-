# ============================================================
#  ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ САЙТА «Понятная еда»
#  Скопируйте этот файл в .env и заполните значения.
#  cp .env.example .env
# ============================================================

# ---------- База данных (ОБЯЗАТЕЛЬНО) ----------
# Строка подключения к вашему PostgreSQL на сервере.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БД
DATABASE_URL=postgresql://ponyatnaya:СЛОЖНЫЙ_ПАРОЛЬ@localhost:5432/ponyatnaya

# Включать SSL для подключения к БД.
# Локальный Postgres на том же сервере — оставьте false (или пусто).
# Внешняя облачная БД, требующая TLS — поставьте true.
DATABASE_SSL=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Роли: кто сотрудник, кто админ (ОБЯЗАТЕЛЬНО) ----------
# Роль выдаётся по номеру телефона при входе/регистрации.
# Телефоны администраторов (полный доступ). Через запятую, в любом формате.
ADMIN_PHONES=+79001234567

# Телефоны сотрудников (доступ к панели без прав администратора). Необязательно.
STAFF_PHONES=79000000000

# ---------- Пароли входа (задаются здесь, в .env) ----------
# Вход этими данными работает СРАЗУ, без предварительной регистрации:
#   - номер из STAFF_PHONES + STAFF_PASSWORD  → вход как сотрудник
#   - номер из ADMIN_PHONES + ADMIN_PASSWORD  → вход как администратор
# Аккаунт создаётся автоматически при первом таком входе.
#
# STAFF_PASSWORD — пароль сотрудника (вход на сайт + доступ в панель, режим «Сотрудник»).
#   Пусто — вход по этим данным отключён, и панель не спрашивает пароль.
STAFF_PASSWORD=STAFF

# ADMIN_PASSWORD — пароль администратора (вход на сайт + режим «Админ»: настройки, рассылки).
#   Пусто — вход по этим данным и режим «Админ» недоступны.
ADMIN_PASSWORD=ADMIN

# ---------- Загрузка файлов на диск (необязательно) ----------
# Куда сохранять загруженные картинки. По умолчанию ./public/uploads.
# Файлы отдаются самим сайтом по адресу, указанному в UPLOAD_PUBLIC_BASE.
# UPLOAD_DIR=/var/www/ponyatnaya/public/uploads
# UPLOAD_PUBLIC_BASE=/uploads

# ---------- Telegram-бот (необязательно) ----------
# Адрес вашего бота (см. папку telegram-bot/ и её README).
# Без него не будут работать рассылки и регистрация через Telegram.
BOT_SERVICE_URL=https://bot.ponyatnayaeda.ru
BOT_SERVICE_API_KEY=ТА_ЖЕ_СТРОКА_ЧТО_API_SECRET_В_БОТЕ

# ---------- Подсказки адресов DaData (необязательно) ----------
# Если не задан — поле адреса просто работает без автоподсказок.
DADATA_API_KEY=

# ---------- Email через Resend (необязательно) ----------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Понятная еда <noreply@ваш-домен.ru>
